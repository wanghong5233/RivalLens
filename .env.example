# RivalLens 环境变量示例
# 复制本文件为 .env 后填入真实值。.env 不入仓库。
# 字段语义见 docs/2-architecture-decision.md 第 3 节与第 12 节。
# 真实凭据获取流程见 docs/private/team-onboarding.md（仅团队内部，gitignore）。

# ==== Database ====
# Async driver (FastAPI runtime)
DATABASE_URL=postgresql+asyncpg://rivallens:rivallens@postgres:5432/rivallens
# Sync driver (Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://rivallens:rivallens@postgres:5432/rivallens

# ==== LLM - Doubao (Volcano Engine) ====
# 必填；占位符必须保留 __REPLACE__ 前缀，scan_secrets 据此识别。
DOUBAO_EP=__REPLACE__DOUBAO_EP__
DOUBAO_API_KEY=__REPLACE__DOUBAO_API_KEY__
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ==== LLM - Qwen (Alibaba Cloud DashScope, OpenAI-compatible) ====
# 可选；仅当 LLM_ACTIVE_PROVIDER=qwen 或任一 LLM_PROVIDER_<SLOT>=qwen 时必填。
QWEN_API_KEY=__REPLACE__QWEN_API_KEY__
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen3.7-plus

# ==== LLM Provider Routing ====
LLM_ACTIVE_PROVIDER=qwen
# Optional per-slot provider override; leave empty to use LLM_ACTIVE_PROVIDER.
LLM_PROVIDER_SUMMARIZATION=
LLM_PROVIDER_RESEARCH=
LLM_PROVIDER_COMPRESSION=
LLM_PROVIDER_QA=
LLM_PROVIDER_WRITER=

# ==== LLM tier routing ====
LLM_TIER_SUMMARIZATION=strong
LLM_TIER_RESEARCH=balanced
LLM_TIER_COMPRESSION=fast
LLM_TIER_QA=balanced
LLM_TIER_WRITER=strong

# ==== LLM model catalog ====
# Doubao endpoint IDs are deployment-specific; leave empty to fall back to DOUBAO_EP.
DOUBAO_MODEL_STRONG=
DOUBAO_MODEL_BALANCED=
DOUBAO_MODEL_FAST=
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_MODEL_BALANCED=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
# Provider forces enable_thinking=false; thinking-default-ON flagships are safe.
QWEN_MODEL_STRONG=qwen3.7-max
QWEN_MODEL_BALANCED=qwen3.7-plus
QWEN_MODEL_FAST=qwen-flash

# ==== LLM 配置式多模型（可选，留空回落到 DOUBAO_EP）====
# Highest-priority escape hatch; leave empty for normal tier/catalog routing.
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_COMPRESSION=
LLM_MODEL_QA=
LLM_MODEL_WRITER=

# ==== Concurrency / Rate limiting ====
LLM_GLOBAL_CONCURRENCY=8
# 0 disables client-side TPM limiting; set to the provider endpoint budget for real runs.
LLM_TPM_BUDGET=0
COLLECTOR_PER_HOST_QPS=1
# Browser-like UA reduces 403s from sites that reject non-browser agents; robots.txt is still honored.
COLLECTOR_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
# Optional paid extractor fallback. Keep enabled in template; disable locally when Tavily quota is exhausted.
COLLECTOR_FETCH_TAVILY_FALLBACK_ENABLED=true
# Last-resort fallback: reuse search snippets when URL extraction fails (reduces empty fetch cards).
COLLECTOR_FETCH_SEARCH_FALLBACK_ENABLED=true
# Multi-provider breadth merge for each language leg (bocha/serper/tavily parallel merge + dedupe).
COLLECTOR_SEARCH_BREADTH_ENABLED=true
# Cooldown window (seconds) after provider quota/auth failures (RateLimited/api_key); 0 disables cooldown.
COLLECTOR_PROVIDER_COOLDOWN_SECONDS=600
COLLECTOR_FETCH_TIMEOUT_S=10
COLLECTOR_ROBOTS_CACHE_TTL_S=3600
COLLECTOR_OFFLINE_SNAPSHOT_DIR=./data/snapshots

# ==== Web Search Provider ====
# 可选；留空时强制走离线快照通道。
TAVILY_API_KEY=__REPLACE__TAVILY_API_KEY__
# Serper（Google SERP 代理）；非中文腿主力，Tavily 退为兜底。留空则不进检索链，行为不变。
# 申请：https://serper.dev（邮箱注册即开，2500 次免费，无需绑卡）
SERPER_API_KEY=__REPLACE__SERPER_API_KEY__
# 博查 Bocha 中文检索（DAQ 管线中文/国内路由）；留空则中文请求仅走 Tavily country。
# 申请：https://open.bochaai.com/api-keys
BOCHA_API_KEY=__REPLACE__BOCHA_API_KEY__
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_RERANK_MODEL=gte-rerank
RERANK_DROP_THRESHOLD=0.2
RERANK_COVERAGE_THRESHOLD=0.5
RERANK_MIN_HIGH_SCORE_PER_DIM=2

# ==== Application ====
LOG_LEVEL=INFO
HTTP_CLIENT_LOG_LEVEL=WARNING
ENVIRONMENT=development
APP_PORT=8000

# ==== LLM runtime controls ====
# Read timeouts use task-class anchors plus latest successful-run floor checks.
# Connect stays tight; read timeout varies by slot to avoid killing long generations.
LLM_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SUMMARIZATION=180
LLM_TIMEOUT_COMPRESSION=120
LLM_TIMEOUT_RESEARCH=90
LLM_TIMEOUT_QA=90
LLM_TIMEOUT_WRITER=180
LLM_CONNECT_TIMEOUT_SECONDS=5
# 0 means unlimited; defaults are sized above recent successful outputs.
LLM_MAX_TOKENS_SUMMARIZATION=4096
LLM_MAX_TOKENS_WRITER=8192
LLM_MAX_TOKENS_COMPRESSION=2048
LLM_MAX_TOKENS_QA=2048
LLM_MAX_TOKENS_RESEARCH=2048
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_CAP_SECONDS=30.0
# Total retry budget per request, as a multiplier of the slot read timeout.
LLM_RETRY_WALL_CLOCK_BUDGET_FACTOR=1.15
LLM_JSON_MODE_ENABLED=true
ORPHAN_RUN_SWEEP_GRACE_SECONDS=300

# ==== Skill Curator Quality Gate ====
# Curator only learns from successful runs. Lower these only for local experiments.
CURATOR_MIN_COVERAGE_RATE=1.0
CURATOR_MIN_DIMENSION_COVERAGE_RATE=0.5
CURATOR_MIN_REPORT_SECTION_COVERAGE_RATE=1.0
CURATOR_MAX_QA_REJECTION_RATE=0.5

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8000
