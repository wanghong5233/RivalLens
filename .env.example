# RivalLens 环境变量示例
# 复制本文件为 .env 后填入真实值。.env 不入仓库。
# 字段语义见 docs/2-architecture-decision.md 第 3 节与第 12 节。

# ==== Database ====
# Async driver (FastAPI runtime)
DATABASE_URL=postgresql+asyncpg://rivallens:rivallens@postgres:5432/rivallens
# Sync driver (Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://rivallens:rivallens@postgres:5432/rivallens

# ==== LLM - Doubao (Volcano Engine) ====
# 课题方提供，账号信息见飞书原文，禁止外泄
DOUBAO_EP=ep-REPLACE-ME
DOUBAO_API_KEY=

# ==== LLM 配置式多模型（可选，留空回落到 DOUBAO_EP）====
# 借鉴 Open Deep Research 的多模型分工，预留扩展位
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_COMPRESSION=
LLM_MODEL_QA=
LLM_MODEL_WRITER=

# ==== Concurrency / Rate limiting ====
LLM_GLOBAL_CONCURRENCY=4
COLLECTOR_PER_HOST_QPS=1
COLLECTOR_USER_AGENT=RivalLens-Researcher/0.1 (+research; bytedance-ai-fullstack-challenge)

# ==== Application ====
LOG_LEVEL=INFO
ENVIRONMENT=development
APP_PORT=8000

# ==== Frontend ====
VITE_API_BASE_URL=http://localhost:8000
