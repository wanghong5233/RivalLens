{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python .cursor/hooks/block-dangerous-shell.py",
        "matcher": "Shell",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "python .cursor/hooks/safety_guard.py",
        "matcher": "Shell",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeReadFile": [
      {
        "command": "python .cursor/hooks/safety_guard.py"
      }
    ]
  }
}
