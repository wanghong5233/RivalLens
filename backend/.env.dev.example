# RivalLens local development template
# This file is safe to commit. Put real values only in local .env files.

# LLM - Doubao
DOUBAO_EP=ep-your-endpoint
DOUBAO_API_KEY=your-api-key

# Optional model routing slots (empty means fallback to DOUBAO_EP)
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_COMPRESSION=
LLM_MODEL_QA=
LLM_MODEL_WRITER=

# Runtime tuning
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LLM_GLOBAL_CONCURRENCY=4
COLLECTOR_PER_HOST_QPS=1
COLLECTOR_USER_AGENT=RivalLens-Researcher/0.1
