# RivalLens local development template
# This file is safe to commit. Put real values only in local .env files.

# LLM - Doubao
DOUBAO_EP=ep-your-endpoint
DOUBAO_API_KEY=your-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# LLM - OpenAI (optional, only required when any LLM_PROVIDER_<SLOT>=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# LLM - Qwen (optional, only required when any LLM_PROVIDER_<SLOT>=qwen)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

# Provider routing slots (default: all doubao; allowed: doubao/openai/qwen)
LLM_PROVIDER_SUMMARIZATION=doubao
LLM_PROVIDER_RESEARCH=doubao
LLM_PROVIDER_COMPRESSION=doubao
LLM_PROVIDER_QA=doubao
LLM_PROVIDER_WRITER=doubao

# Optional model routing slots (empty means fallback to DOUBAO_EP)
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_COMPRESSION=
LLM_MODEL_QA=
LLM_MODEL_WRITER=

# Runtime tuning
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LANGGRAPH_CHECKPOINT_DSN=postgresql://postgres:pg123456@rivallens_db:5432/rivallens_dev
LLM_GLOBAL_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
COLLECTOR_PER_HOST_QPS=1
COLLECTOR_USER_AGENT=RivalLens-Researcher/0.1
DEMO_FIXTURES_DIR=/demo_fixtures

# Web Search Provider
TAVILY_API_KEY=
# Bocha Chinese search (DAQ locale routing); leave empty to skip Bocha channel.
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com/v1
BOCHA_RERANK_MODEL=gte-rerank
RERANK_DROP_THRESHOLD=0.2
RERANK_COVERAGE_THRESHOLD=0.5
RERANK_MIN_HIGH_SCORE_PER_DIM=2
