{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/safety_guard.py",
            "timeout": 30,
            "statusMessage": "Checking shell command"
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .codex/hooks/safety_guard.py",
            "timeout": 30,
            "statusMessage": "Checking file edit"
          }
        ]
      }
    ]
  }
}
