{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/safety_guard.py",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "afterFileEdit": [
      {
        "command": "python .cursor/hooks/safety_guard.py",
        "timeout": 10,
        "failClosed": false
      }
    ],
    "beforeReadFile": [
      {
        "command": "python .cursor/hooks/safety_guard.py",
        "timeout": 10,
        "failClosed": false
      }
    ]
  }
}
