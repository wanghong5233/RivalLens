# RivalLens local development template
# This file is safe to commit. Put real values only in local .env files.

# LLM - Doubao
DOUBAO_EP=ep-your-endpoint
DOUBAO_API_KEY=your-api-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# LLM - OpenAI (optional, only required when any LLM_PROVIDER_<SLOT>=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Provider routing slots (default: all doubao)
LLM_PROVIDER_SUMMARIZATION=doubao
LLM_PROVIDER_RESEARCH=doubao
LLM_PROVIDER_COMPRESSION=doubao
LLM_PROVIDER_QA=doubao
LLM_PROVIDER_WRITER=doubao

# Optional model routing slots (empty means fallback to DOUBAO_EP)
LLM_MODEL_SUMMARIZATION=
LLM_MODEL_RESEARCH=
LLM_MODEL_COMPRESSION=
LLM_MODEL_QA=
LLM_MODEL_WRITER=

# Runtime tuning
ENVIRONMENT=development
LOG_LEVEL=DEBUG
LLM_GLOBAL_CONCURRENCY=4
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
COLLECTOR_PER_HOST_QPS=1
COLLECTOR_USER_AGENT=RivalLens-Researcher/0.1
